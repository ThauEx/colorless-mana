<div class="search-form">
    {{ form_start(form) }}

    {% if form.users is defined %}
    <div class="row">
        <div class="col-md-4">
            {{ form_row(form.users) }}
        </div>
    </div>
    {% endif %}

    {# One shared row so hidden filters (choices|length < 2) don't leave gaps:
       Bootstrap's grid wraps remaining columns across what used to be two
       separate rows, instead of each row reflowing only among itself. #}
    <div class="row">
        <div class="col-md-3">
            {{ form_row(form.term) }}
        </div>
        <div class="col-md-3{{ form.supertypes.vars.choices|length < 2 ? ' d-none' }}">
            {{ form_row(form.supertypes) }}
        </div>
        <div class="col-md-3{{ form.types.vars.choices|length < 2 ? ' d-none' }}">
            {{ form_row(form.types) }}
        </div>
        <div class="col-md-3{{ form.subtypes.vars.choices|length < 2 ? ' d-none' }}">
            {{ form_row(form.subtypes) }}
        </div>
        <div class="col-md-3{{ form.colors.vars.choices|length < 2 ? ' d-none' }}">
            {{ form_row(form.colors) }}
        </div>
        <div class="col-md-3{{ form.rarities.vars.choices|length < 2 ? ' d-none' }}">
            {{ form_row(form.rarities) }}
        </div>
        <div class="col-md-3{{ form.setCodes.vars.choices|length < 2 ? ' d-none' }}">
            {{ form_row(form.setCodes) }}
        </div>
        <div class="col-md-3{{ form.languages.vars.choices|length < 2 ? ' d-none' }}">
            {{ form_row(form.languages) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            {{ form_row(form.colorMatch) }}
        </div>
        <div class="col-md-2">
            {{ form_row(form.finishes) }}
        </div>
        <div class="col-md-2">
            {{ form_row(form.order) }}
        </div>
        <div class="col-md-2">
            {{ form_row(form.dir) }}
        </div>
        <div class="col-md-3 text-end" style="display: flex; align-items: flex-end; justify-content: flex-end;">
            <button class="btn btn-primary mb-3" type="submit">{{ 'form.search'|trans }}</button>
        </div>
    </div>
    {{ form_end(form) }}
</div>
<hr>
